    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/postcss": "^4.2.2",
        "@tailwindcss/typography": "^0.5.19",
        "autoprefixer": "^10.4.27",
        "postcss": "^8.5.8",
        "postcss-cli": "^11.0.1",
        "tailwindcss": "^4.2.2"
    }
}