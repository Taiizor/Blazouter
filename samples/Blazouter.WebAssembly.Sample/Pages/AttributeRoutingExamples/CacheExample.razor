<div class="max-w-4xl mx-auto px-4 py-8">
	<h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">Route Cache Attribute</h1>
	<p class="text-gray-600 dark:text-gray-400 mb-8">
		This page demonstrates using the <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">[RouteCache]</code> attribute 
		to control per-route caching declaratively.
	</p>

	<!-- This Page's Configuration -->
	<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
		<div class="p-6">
			<h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">📝 This Page Configuration</h2>
			<p class="text-gray-600 dark:text-gray-400 mb-4">This component uses the following attributes:</p>
			<div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 font-mono text-sm mb-4">
				<div class="text-gray-800 dark:text-gray-200">[<span class="text-blue-600 dark:text-blue-400">RouteTitle</span>(<span class="text-orange-600 dark:text-orange-400">"Cache Example"</span>)]</div>
				<div class="text-gray-800 dark:text-gray-200">[<span class="text-blue-600 dark:text-blue-400">Route</span>(<span class="text-orange-600 dark:text-orange-400">"/attribute-examples/cache"</span>)]</div>
				<div class="text-gray-800 dark:text-gray-200">[<span class="text-blue-600 dark:text-blue-400">RouteCache</span>(<span class="text-purple-600 dark:text-purple-400">false</span>)]  <span class="text-gray-500">// Never cached!</span></div>
			</div>

			<div class="bg-red-50 dark:bg-red-900/20 border-2 border-red-200 dark:border-red-800 rounded-lg p-4">
				<h3 class="font-semibold text-red-900 dark:text-red-100 mb-2">❌ Caching Disabled</h3>
				<p class="text-red-800 dark:text-red-200 text-sm">
					This route has <code class="bg-red-200 dark:bg-red-800 px-1 rounded">[RouteCache(false)]</code> applied, 
					so it will never be cached. Navigate away and back - this route won't appear in cache hits!
				</p>
			</div>
		</div>
	</div>

	<!-- Usage Examples -->
	<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
		<div class="p-6">
			<h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">💡 Usage Examples</h2>

			<div class="space-y-6">
				<div>
					<h3 class="font-semibold text-gray-900 dark:text-white mb-2">Disable Caching</h3>
					<pre class="bg-gray-900 text-white p-4 rounded-lg text-sm overflow-x-auto">[Route("/admin/dashboard")]
[RouteCache(false)]  // Never cache this route
public class AdminDashboard : ComponentBase { }</pre>
				</div>

				<div>
					<h3 class="font-semibold text-gray-900 dark:text-white mb-2">Force Caching</h3>
					<pre class="bg-gray-900 text-white p-4 rounded-lg text-sm overflow-x-auto">[Route("/static-page")]
[RouteCache(true)]   // Always cache (even if global caching disabled)
public class StaticPage : ComponentBase { }</pre>
				</div>

				<div>
					<h3 class="font-semibold text-gray-900 dark:text-white mb-2">Use Global Settings (Default)</h3>
					<pre class="bg-gray-900 text-white p-4 rounded-lg text-sm overflow-x-auto">[Route("/default")]
// No [RouteCache] attribute = use global cache settings
public class DefaultPage : ComponentBase { }</pre>
				</div>
			</div>
		</div>
	</div>

	<!-- Cache Statistics -->
	<div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
		<div class="p-6">
			<h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">📊 Current Cache Statistics</h2>

			@if (_stats != null)
			{
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					<div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg">
						<div class="text-sm text-blue-600 dark:text-blue-400">Total Requests</div>
						<div class="text-xl font-bold text-blue-900 dark:text-blue-100">@_stats.TotalRequests.ToString("N0")</div>
					</div>
					<div class="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg">
						<div class="text-sm text-green-600 dark:text-green-400">Cache Hits</div>
						<div class="text-xl font-bold text-green-900 dark:text-green-100">@_stats.CacheHits.ToString("N0")</div>
					</div>
					<div class="bg-red-50 dark:bg-red-900/20 p-4 rounded-lg">
						<div class="text-sm text-red-600 dark:text-red-400">Cache Misses</div>
						<div class="text-xl font-bold text-red-900 dark:text-red-100">@_stats.CacheMisses.ToString("N0")</div>
					</div>
					<div class="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-lg">
						<div class="text-sm text-purple-600 dark:text-purple-400">Hit Rate</div>
						<div class="text-xl font-bold text-purple-900 dark:text-purple-100">@_stats.HitRate.ToString("F1")%</div>
					</div>
				</div>
			}
			else
			{
				<p class="text-gray-500 dark:text-gray-400">Statistics not available. Enable with <code>options.EnableStatistics = true</code></p>
			}
		</div>
	</div>

	<!-- Navigation -->
	<div class="flex gap-4">
		<button @onclick='() => NavigationService.NavigateTo("/attribute-examples")'
				class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition cursor-pointer">
			← Back to Examples
		</button>
		<button @onclick='() => NavigationService.NavigateTo("/cache")'
				class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition cursor-pointer">
			View Full Cache Demo →
		</button>
	</div>
</div>