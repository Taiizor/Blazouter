<Router Routes="@_routes" DefaultLayout="typeof(MainLayout)"
		OnNavigateAsync="@OnNavigateAsync"
		AdditionalAssemblies="@_lazyLoadedAssemblies">
	<ErrorContent Context="errorInfo">
		<div class="px-4 py-16">
			<div class="max-w-2xl mx-auto">
				<div class="bg-red-50 dark:bg-red-900/20 border-2 border-red-200 dark:border-red-800 rounded-xl p-8">
					<div class="flex items-start">
						<div class="flex-shrink-0">
							<svg class="h-12 w-12 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
							</svg>
						</div>
						<div class="ml-4 flex-1">
							<h1 class="text-2xl font-bold text-red-800 dark:text-red-300 mb-2">
								⚠️ Routing Error
							</h1>
							<p class="text-red-700 dark:text-red-400 mb-2">
								<strong>@errorInfo.ErrorType</strong>
							</p>
							<p class="text-gray-700 dark:text-gray-300 mb-4">
								@errorInfo.Message
							</p>
							@if (errorInfo.Url != null)
							{
								<p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
									<strong>URL:</strong> @errorInfo.Url
								</p>
							}
							<div class="flex gap-3">
								@if (errorInfo.Retry != null)
								{
									<button @onclick="@errorInfo.Retry"
											class="px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-semibold">
										Try Again
									</button>
								}
								<button @onclick='@(() => _navService.NavigateTo("/"))'
										class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors font-semibold">
									Go to Home
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</ErrorContent>
	<NotFound>
		<div class="px-4 py-16 text-center">
			<div class="max-w-2xl mx-auto">
				<h1 class="text-6xl font-bold text-gray-900 dark:text-white mb-4">404</h1>
				<h2 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-4">Page Not Found</h2>
				<p class="text-gray-600 dark:text-gray-400 mb-8">
					The page you are looking for doesn't exist.
				</p>
				<button @onclick='@(() => _navService.NavigateTo("/"))'
						class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
					Go to Home
				</button>
			</div>
		</div>
	</NotFound>
	<Loading>
		<div class="flex items-center justify-center min-h-screen">
			<div class="text-center">
				<div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
				<p class="mt-4 text-gray-600 dark:text-gray-400">Loading...</p>
			</div>
		</div>
	</Loading>
</Router>